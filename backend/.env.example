DB_URL=postgresql://localhost/political_tracker

# Neon branch switching — set NEON_BRANCH=DEMO or NEON_BRANCH=PRODUCTION
# When set, DB_URL is ignored in favour of the branch-specific URL below
NEON_BRANCH=
DB_URL_DEMO=
DB_URL_PRODUCTION=

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

EXA_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Comma-separated list of additional CORS origins beyond localhost
ALLOWED_ORIGINS=
